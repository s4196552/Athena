# Signs the session cookie (HMAC-SHA256). Required in production -- the app
# throws at first use rather than silently rejecting every session.
# Generate one with: openssl rand -base64 32
AUTH_SECRET=

# Which repository driver backs the catalogue. Only "json" exists today; it
# reads the committed fixtures under data/seed/.
ATHENA_DATA_DRIVER=json

# Optional. The landing page shows this gateway's health, fetched server-side
# so the browser makes no cross-origin request and the CSP can stay 'self'.
# ATHENA_GATEWAY_URL=https://your-gateway.up.railway.app

# Optional. Enables the model-written opening paragraph on "Summarise this
# selection". Without it the site still produces the counted brief, which is
# the half that carries every number.
#
# Get one at https://aistudio.google.com/apikey. Set a spending limit there
# too if this deployment is public -- the per-viewer and per-instance caps in
# lib/brief/budget.ts are speed bumps, not a billing guarantee.
# GEMINI_API_KEY=
#
# Optional overrides.
# GEMINI_MODEL=gemini-3.1-flash
# ATHENA_AI_VIEWER_DAILY=25
# ATHENA_AI_DAILY_MAX=400
