{
  "name": "athena-cloud",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=20.9"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "seed": "tsx scripts/generate-seed.mts && tsx scripts/build-graph.mts",
    "check:taxonomy": "tsx scripts/check-taxonomy-parity.mts",
    "check:pyramid": "tsx tests/pyramid.mts",
    "check:contrast": "tsx scripts/check-contrast.mts",
